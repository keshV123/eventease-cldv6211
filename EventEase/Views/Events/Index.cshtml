@model IEnumerable<EventEase.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<h1>Events</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Event</a>
</p>

<form method="get" asp-action="Index" class="mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Search</label>
            <input type="text" name="searchString" class="form-control"
                   placeholder="Search by title..."
                   value="@Context.Request.Query["searchString"]" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Event Type</label>
            <select name="eventTypeId" class="form-select" asp-items="@(ViewData["EventTypeId"] as SelectList)">
                <option value="">All Types</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">From Date</label>
            <input type="date" name="fromDate" class="form-control"
                   value="@Context.Request.Query["fromDate"]" />
        </div>
        <div class="col-md-2">
            <label class="form-label">To Date</label>
            <input type="date" name="toDate" class="form-control"
                   value="@Context.Request.Query["toDate"]" />
        </div>
        <div class="col-md-3 d-flex align-items-end gap-2">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="venueAvailable"
                       value="true" id="venueAvailable"
                       @(Context.Request.Query["venueAvailable"] == "true" ? "checked" : "") />
                <label class="form-check-label" for="venueAvailable">
                    Available venues only
                </label>
            </div>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary w-100">Filter</button>
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Reset</a>
        </div>
    </div>
</form>

<div class="row">

    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">

            <div class="card shadow-sm h-100">

                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl"
                         class="card-img-top"
                         style="height: 220px;
                    object-fit: cover;" />
                }

                <div class="card-body d-flex flex-column">

                    <h5 class="card-title">
                        @item.Title
                    </h5>

                    <p class="card-text">
                        <strong>Date:</strong>
                        @item.Date.ToString("dd MMM yyyy HH:mm")
                    </p>

                    <p class="card-text">
                        <strong>Venue:</strong>
                        @item.Venue?.VenueName
                    </p>

                    @if (item.EventType != null)
                    {
                        <p class="card-text">
                            <strong>Type:</strong>
                            @item.EventType.TypeName
                        </p>
                    }

                    <p class="card-text">
                        @item.Description
                    </p>

                    <div class="mt-auto">

                        <a asp-action="Edit"
                               asp-route-id="@item.EventId"
                               class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Details"
                               asp-route-id="@item.EventId"
                               class="btn btn-info btn-sm">
                            Details
                        </a>

                        <a asp-action="Delete"
                               asp-route-id="@item.EventId"
                               class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>