@model IEnumerable<EventEase.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<h1>Events</h1>

<p>
    <a asp-action="Create"
           class="btn btn-primary">
        Create New Event
    </a>
</p>

<div class="row">

    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">

            <div class="card shadow-sm h-100">

                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl"
                         class="card-img-top"
                         style="height: 220px;
                    object-fit: cover;" />
                }

                <div class="card-body d-flex flex-column">

                    <h5 class="card-title">
                        @item.Title
                    </h5>

                    <p class="card-text">
                        <strong>Date:</strong>
                        @item.Date.ToString("dd MMM yyyy HH:mm")
                    </p>

                    <p class="card-text">
                        <strong>Venue:</strong>
                        @item.Venue?.VenueName
                    </p>

                    <p class="card-text">
                        @item.Description
                    </p>

                    <div class="mt-auto">

                        <a asp-action="Edit"
                               asp-route-id="@item.EventId"
                               class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Details"
                               asp-route-id="@item.EventId"
                               class="btn btn-info btn-sm">
                            Details
                        </a>

                        <a asp-action="Delete"
                               asp-route-id="@item.EventId"
                               class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>